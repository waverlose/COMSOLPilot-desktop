{
  "name": "comsolpilot-desktop",
  "productName": "COMSOLPilot",
  "private": true,
  "version": "0.2.1",
  "type": "module",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "tauri:build:nsis": "tauri build --bundles nsis",
    "version:sync": "node scripts/sync-version.mjs",
    "version:check": "node scripts/sync-version.mjs --check",
    "signer:generate": "tauri signer generate -w .tauri/comsolpilot.key",
    "electron:compile": "node scripts/compile-electron.mjs",
    "electron:start": "npm run electron:compile && node scripts/start-electron.mjs",
    "electron:dev": "npm run electron:compile && concurrently -k -n vite,electron -c cyan,magenta \"npm:dev\" \"node scripts/start-electron.mjs\"",
    "electron:build": "npm run build && npm run electron:compile && electron-builder --win",
    "sidecar": "python python-sidecar/sidecar_server.py",
    "sidecar:setup": "node scripts/setup-sidecar-env.mjs",
    "sidecar:build": "python python-sidecar/build_sidecar.py",
    "icons": "python scripts/generate_icons.py"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.1.1",
    "@tauri-apps/plugin-dialog": "^2.0.1",
    "@tauri-apps/plugin-shell": "^2.0.1",
    "lucide-react": "^0.383.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.1.0",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.0",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.15",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  }
}
